# NextAuth
# NEXTAUTH_URL: only needed for local dev. On Vercel this is derived automatically
# from the deployment's own URL (see lib/env.ts) — do not set it there.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-string   # generate with: openssl rand -base64 32

# Google OAuth client (Google Cloud Console -> APIs & Services -> Credentials)
# Authorized redirect URI: <your app's URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Anthropic (Claude) API key, used to extract receipt details from the uploaded file
ANTHROPIC_API_KEY=sk-ant-...
# Optional override, defaults to claude-sonnet-5
ANTHROPIC_MODEL=claude-sonnet-5
